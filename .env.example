# ==============================
# DreamPulse 环境变量模板
# 复制此文件为 .env.local 并填入真实值
# ==============================

# 站点 URL（Cloudflare Pages 域名）
NEXT_PUBLIC_SITE_URL=https://dreampulse.pages.dev

# Auth.js v5 配置（仅需邮箱密码登录，OAuth 后期按需开启）
AUTH_SECRET=your-auth-secret-min-32-chars
AUTH_URL=https://dreampulse.pages.dev

# OpenAI API（AI 摘要改写）
OPENAI_API_KEY=your-openai-api-key

# Cloudflare D1
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-id

# Cloudflare R2
CLOUDFLARE_R2_BUCKET_NAME=dreampulse-assets

# Cloudflare KV
CLOUDFLARE_KV_NAMESPACE_ID=your-kv-namespace-id

# ==============================
# 以下为后期按需配置（当前不需要）
# ==============================

# Google OAuth（后期开启）
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth（后期开启）
# GITHUB_ID=your-github-client-id
# GITHUB_SECRET=your-github-client-secret

# Twilio 年龄验证短信服务（成人版块开启时需要）
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid
