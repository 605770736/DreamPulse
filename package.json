{
  "name": "dreampulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:build": "@cloudflare/next-on-pages",
    "pages:dev": "wrangler pages dev .vercel/output/static --compatibility-date=2024-12-01",
    "pages:deploy": "wrangler pages deploy .vercel/output/static",
    "db:migrate": "wrangler d1 execute dreampulse-db --file=src/lib/db/migrations/0001_init.sql",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@auth/core": "^0.37.0",
    "@auth/d1-adapter": "^1.11.0",
    "next-auth": "^5.0.0-beta.25",
    "next-intl": "^3.26.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "zod": "^3.24.0",
    "lucide-react": "^0.468.0",
    "openai": "^4.77.0",
    "cheerio": "^1.0.0",
    "nanoid": "^5.0.9",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.0",
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.5.0",
    "wrangler": "^3.99.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "vitest": "^2.1.0"
  }
}
